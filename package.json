{
  "name": "packetlens",
  "private": true,
  "version": "1.0.0",
  "description": "Open and dissect packet captures (pcap/pcapng) on your iPhone, offline, with Wireshark's dissection engine compiled to WebAssembly.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-wiregasm.mjs",
    "dev": "npm run assets && vite",
    "build": "npm run assets && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node tests/dissect.test.mjs",
    "test:webkit": "node tests/webkit/app.mjs",
    "cap:sync": "npm run build && cap sync ios"
  },
  "dependencies": {
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@goodtools/wiregasm": "2.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
